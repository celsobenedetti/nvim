{
  "code block": {
    "description": "code block",
    "prefix": "cb",
    "body": ["#+begin_src ${1:bash}", "$0", "#+end_src"]
  },
  "todo bullet list": {
    "description": "todo bullet list",
    "prefix": "t",
    "body": ["- [ ] $1"]
  },
  "drawer": {
    "description": "drawer",
    "prefix": "dr",
    "body": [":${3:properties}:", "${2::ID:} $1", ":${4:end}:"]
  },
  "link": {
    "description": "link",
    "prefix": "li",
    "body": ["[[$2][$1]]"]
  }
}
