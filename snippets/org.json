{
  "code block": {
    "description": "code block",
    "prefix": "cb",
    "body": ["#+begin_src ${1:bash}", "$0", "#+end_src"]
  },
  "todo bullet list": {
    "description": "todo bullet list",
    "prefix": "t",
    "body": ["- [ ] $1"]
  },
  "id": {
    "description": "id property",
    "prefix": "id",
    "body": [":PROPERTIES:", ":${2:ID}: $1", ":END:"]
  },
  "link": {
    "description": "link",
    "prefix": "li",
    "body": ["[[$2][$1]]"]
  }
}
